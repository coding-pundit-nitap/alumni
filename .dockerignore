# Build context for docker/*.Dockerfile: sources and lockfile only. Secrets and local state never enter an image.
# No broad name patterns (compose*, bin, ...): they match source files such as apps/worker/src/compose.ts.
**/node_modules
**/.next
**/.turbo
**/dist
**/coverage
**/playwright-report
**/test-results
**/*.tsbuildinfo
.git
**/.env
**/.env.*
!**/.env.example
docs
perf/results
.drill-restore
.drill-release
.drill-alerts
.migration-locks
